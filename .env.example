# Copy to .env and adjust. docker-compose provides these defaults out of the box.
DATABASE_URL=postgresql+psycopg://planmytrip:planmytrip@localhost:5432/planmytrip
APP_ENV=development

# --- Real flight & hotel data (optional) ---
# Free keys at https://developers.amadeus.com (create an app -> API Key/Secret).
# Leave blank to use generated sample options. Keep the test URL for the free tier.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
