# Copy to .env and adjust. docker-compose provides these defaults out of the box.
DATABASE_URL=postgresql+psycopg://planmytrip:planmytrip@localhost:5432/planmytrip
APP_ENV=development

# --- Real flight & hotel data (optional) ---
# One RapidAPI key (free "Basic" plan) covers flights AND hotels via Sky-Scrapper:
#   https://rapidapi.com/apiheya/api/sky-scrapper  -> Subscribe -> Basic (Free).
# Leave blank to use generated sample options.
RAPIDAPI_KEY=
RAPIDAPI_HOST=sky-scrapper.p.rapidapi.com
